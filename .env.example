# Copie para .env e preencha. .env e ignorado pelo git.
# Provedor do LLM: groq (default) | ollama | openai
LLM_PROVIDER=groq
# Key do provedor (Groq: https://console.groq.com/keys). Ollama nao precisa.
LLM_API_KEY=
# Opcional: sobrescreve o modelo/URL default do provedor
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=
# API de cotacao
QUOTE_URL=http://localhost:8000
